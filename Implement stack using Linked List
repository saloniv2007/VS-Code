#include <stdio.h>
#include <stdlib.h>

struct Node {
    int data;
    struct Node *next;
};

struct Node *top = NULL;
\\push
void push(int value) {
    struct Node *newNode;

    newNode = (struct Node *)malloc(sizeof(struct Node));
    if (newNode == NULL) {
        printf("Stack overflow\n");
        return;
    }
    newNode->data = value;
    newNode->next = top;
    top = newNode;

    printf("%d pushed into stack\n", value);
}
\\pop
void pop() {
    struct Node *temp;
    if (top == NULL) {
        printf("Stack underflow\n");
        return;
    }
    temp = top;
    printf("%d popped from stack\n", top->data);
    top = top->next;
    free(temp);
}
//peek
void peek() {
    if (top == NULL) {
        printf("Stack is empty\n");
        return;}
printf("Element at the top = %d\n", top->data);
}

//display
void display() {
    struct Node *temp = top;
    if (top == NULL) {
        printf("Stack is empty\n");
        return;
    }

    printf("Stack elements: ");
    while (temp != NULL) {
        printf("%d ", temp->data);
        temp = temp->next;
    }
    printf("\n");}

int main() {
    push(10);
    push(20);
    push(30);
    pop();
    peek();
    display();
    return 0;
}
