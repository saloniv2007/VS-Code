#include<stdio.h>
int main(){
    int arr[5]={10,20,30,40,50};

    int i , j, n=5 ;
    int target=90;
    
    for(i=0; i<n; i++){

        for(j=i+1; j<n; j++){

            if (arr[i]+arr[j]==target){

                printf("%d %d ", i,j);
            }
        }
        
    }
    return 0;
}
