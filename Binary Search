#include<stdio.h>
int main(){
    int arr[5]= {10,20,30,40,50};
    int i,n=5 ,key;
    int low=0;
    int high=n-1;

    printf("Enter key: ");
    scanf("%d", &key);
    while(low<=high){
        int mid = (low+high)/2;

        if(arr[mid]==key){
            printf("Element found at index %d",mid);
            return 0;
        }
        else if (arr[mid]<key){
            low=mid+1;}
            else{
            high=mid-1;}
        }
return 0;
    }
