#include<stdio.h>
#define N 5
 int queue[N];
int front= -1;
int rear=-1;

void enqueue(int x){
    if(rear == N-1){
        printf("Queue is empty");
        return; 
    }
    else{
        if(front==-1){
            front =0;}
        rear++;
        queue[rear]=x;
        printf("Insertion: %d\n", x);
    }
}

    void dequeue(){
        if(front ==-1){
            printf("Queue is empty");
            return;
        }
        else{
            printf("Deletion: %d\n", queue[front]);
            front++;
        }
        if (front>rear){
            front = rear = -1;
        }}
        void display(){
            if (front ==-1){
            printf("Queue is empty");
            return;}
            for(int i=front;i<=rear;i++){
                printf("%d\n",queue[i] );
            }
        }
        int main(){
            enqueue(10);
            enqueue(20);
            enqueue(30);
            display();
            dequeue();
            display();

            return 0;
        }
    
